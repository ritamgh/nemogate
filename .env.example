# Copy to .env and fill in. .env is gitignored. Never commit it, paste it, or show it on screen.
# Only common/ reads these values. Non-secret settings (base URL, model IDs, prices) go in config.yaml.

# One Token Factory key and project serve both Token Factory (models) and Sandboxes (Contree).
# Per the Nebius Sandboxes docs, contree-sdk reads exactly these two names (docs/FACTS.md section 3).
# The SDK needs NEBIUS_PROJECT_ID; NEBIUS_AI_PROJECT does not replace it.
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
# Only the `contree` CLI reads this (for `contree auth`). Set it to the same project ID.
NEBIUS_AI_PROJECT=

# Real model calls stay off by default. Set this per command (NEMOGATE_LIVE=1 uv run ...), not here.
# NEMOGATE_LIVE=0
