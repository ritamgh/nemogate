# Copy to .env and fill in. .env is gitignored. Never commit it, paste it, or show it on screen.
# Only common/ reads these values. Non-secret settings (base URL, model IDs, prices) go in config.yaml.

# Nebius Token Factory API key (OpenAI-compatible endpoint).
# Variable name chosen by us; verify the base URL and auth scheme in the day-0 spike (docs/FACTS.md section 2).
NEBIUS_API_KEY=

# Contree / Nebius Sandboxes credentials.
# PLACEHOLDER: the SDK's expected variable name(s) are not verified yet (docs/FACTS.md section 3).
# Rename these to match the SDK once the spike confirms them.
CONTREE_API_KEY=
NEBIUS_PROJECT_ID=

# Real model calls stay off by default. Set this per command (NEMOGATE_LIVE=1 uv run ...), not here.
# NEMOGATE_LIVE=0
